    "dev:figma:port3202": "next dev ./apps/figma --port 3202 --webpack",
    "dev:youtube:port3203": "next dev ./apps/youtube --port 3203 --webpack",
    "dev:docs:port3204": "next dev ./apps/docs --port 3204 --webpack",
    "dev:discord:port3205": "next dev ./apps/discord --port 3205 --webpack",
    "dev:mailo:port3207": "next dev ./apps/mailo --port 3207 --webpack",
    "dev:devhub:port3208": "next dev ./apps/devhub --port 3208 --webpack",
    "dev:dayplan:port3209": "next dev ./apps/dayplan --port 3209 --webpack",
    "dev:gridly:port3211": "next dev ./apps/gridly --port 3211 --webpack",
    "dev:wayfind:port3212": "next dev ./apps/wayfind --port 3212 --webpack",
    "dev:devpad:port3213": "next dev ./apps/devpad --port 3213 --webpack",
    "dev:pagely:port3214": "next dev ./apps/pagely --port 3214 --webpack",
    "dev:chirp:port3215": "next dev ./apps/chirp --port 3215 --webpack",
